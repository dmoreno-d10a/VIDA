# Variables de entorno de V.I.D.A. — PLANTILLA
#
# Copia este archivo a `.env` y ajusta los valores:
#
#     cp .env.ejemplo .env
#
# `.env` está ignorado por git y nunca se versiona (Art. X.2 de la constitución).
# Este archivo solo lleva valores de ejemplo para desarrollo local:
# ningún secreto, key ni credencial real va aquí.


# --- Base de datos (Art. X: sin credenciales reales en el repositorio) ---------

# Cadena de conexión que usa el backend. No tiene valor por defecto:
# si falta, el backend no arranca (RF-23).
VIDA_BD_URL=postgresql+psycopg://vida:cambia-esta-contrasena-local@localhost:5432/vida

# Las usa docker-compose para levantar PostgreSQL en desarrollo.
# VIDA_BD_CONTRASENA no tiene valor por defecto a propósito: sin ella,
# `docker compose up` falla con un mensaje claro en vez de arrancar con
# una contraseña conocida escrita en el repositorio.
VIDA_BD_USUARIO=vida
VIDA_BD_CONTRASENA=cambia-esta-contrasena-local
VIDA_BD_NOMBRE=vida
# Si el 5432 ya está ocupado en tu máquina (otro PostgreSQL u otro proyecto),
# cambia este puerto y el de VIDA_BD_URL. No hace falta tocar docker-compose.yml.
VIDA_BD_PUERTO=5432


# --- Sesión (RF-07) -----------------------------------------------------------

# Duración de la sesión, en minutos.
VIDA_SESION_MINUTOS=480


# --- Política de contraseñas (RF-20, RF-23) -----------------------------------

# Longitud mínima y máxima. No se exige combinación de tipos de carácter.
VIDA_CONTRASENA_MIN=12
VIDA_CONTRASENA_MAX=64

# Ruta de la lista de contraseñas de uso común que se rechazan.
VIDA_CONTRASENAS_COMUNES=app/datos/contrasenas-comunes.txt


# --- Bloqueo por intentos fallidos (RF-22, RF-23) -----------------------------

# Intentos fallidos seguidos antes de bloquear la cuenta, y duración del
# bloqueo en minutos. El bloqueo se levanta por tiempo, sin intervención.
VIDA_INTENTOS_MAX=5
VIDA_BLOQUEO_MINUTOS=15


# --- Administrador inicial (RF-18) --------------------------------------------

# Solo se usan en la puesta en marcha, al ejecutar el comando que crea el
# primer Administrador. Si no defines la contraseña, el comando la pide por
# consola sin mostrarla. No dejes una contraseña real en este archivo.
VIDA_ADMIN_INICIAL=admin@ejemplo.local
VIDA_ADMIN_INICIAL_CONTRASENA=


# --- Front (Art. IV: el front no guarda credenciales) -------------------------

# Dirección del backend. Es lo único que el front necesita saber.
VIDA_API_URL=http://localhost:8000
